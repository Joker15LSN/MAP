{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://map.local/schemas/acceptance/evidence-manifest-1.1.0.json",
  "title": "MAP acceptance evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "ac_id",
    "status",
    "baseline_sha",
    "implementation_sha",
    "environment_digest",
    "started_at",
    "finished_at",
    "command",
    "exit_code",
    "artifacts",
    "assertions",
    "finding_ids",
    "waiver_id",
    "waiver_owner",
    "waiver_expires_at",
    "not_applicable_reason",
    "blocked_reason",
    "blocker_owner",
    "superseded_by",
    "superseded_reason",
    "producer"
  ],
  "properties": {
    "schema_version": {
      "enum": ["1.1.0", "1.2.0"]
    },
    "task_id": {
      "type": "string",
      "pattern": "^(P[0-2]-[A-Z0-9-]+|GLOBAL)$"
    },
    "ac_id": {
      "type": "string",
      "pattern": "^AC-[A-Z0-9-]+$"
    },
    "status": {
      "enum": [
        "not-run",
        "running",
        "pass",
        "fail",
        "blocked",
        "superseded",
        "not-applicable-approved"
      ]
    },
    "baseline_sha": {
      "$ref": "#/$defs/git_oid"
    },
    "implementation_sha": {
      "$ref": "#/$defs/git_oid"
    },
    "environment_digest": {
      "$ref": "#/$defs/sha256"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "exit_code": {
      "type": "integer"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "media_type"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"},
          "media_type": {"type": "string", "minLength": 1}
        }
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "expected", "actual", "result"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "expected": {},
          "actual": {},
          "result": {"enum": ["pass", "fail"]}
        }
      }
    },
    "finding_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "waiver_id": {
      "type": ["string", "null"]
    },
    "waiver_owner": {
      "type": ["string", "null"]
    },
    "waiver_expires_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "not_applicable_reason": {
      "type": ["string", "null"]
    },
    "blocked_reason": {
      "type": ["string", "null"]
    },
    "blocker_owner": {
      "type": ["string", "null"]
    },
    "superseded_by": {
      "type": ["string", "null"],
      "description": "Replacement evidence location (task/sha/ac path) when status=superseded"
    },
    "superseded_reason": {
      "type": ["string", "null"]
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "version"],
      "properties": {
        "agent": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "attestation": {
      "description": "S4-03: SLSA/in-toto-like attestation binding the manifest to a trusted CI workflow. Required (non-null) for pass / not-applicable-approved; null for all other statuses.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["type", "issuer", "workflow", "signatures"],
      "properties": {
        "type": {"const": "map-acceptance-evidence/v1"},
        "issuer": {"type": "string", "minLength": 1},
        "workflow": {"type": "string", "minLength": 1},
        "signatures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key_id", "algorithm", "signature"],
            "properties": {
              "key_id": {"type": "string", "minLength": 1},
              "algorithm": {"const": "ed25519"},
              "signature": {"$ref": "#/$defs/ed25519_signature"}
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {"const": "not-applicable-approved"}
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "waiver_id": {"type": "string", "minLength": 1},
          "waiver_owner": {"type": "string", "minLength": 1},
          "waiver_expires_at": {"type": "string", "format": "date-time"},
          "not_applicable_reason": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"not": {"const": "not-applicable-approved"}}
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "waiver_id": {"type": "null"},
          "waiver_owner": {"type": "null"},
          "waiver_expires_at": {"type": "null"},
          "not_applicable_reason": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"const": "blocked"}
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "blocked_reason": {"type": "string", "minLength": 1},
          "blocker_owner": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"not": {"const": "blocked"}}
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "blocked_reason": {"type": "null"},
          "blocker_owner": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"const": "superseded"}
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "superseded_by": {"type": "string", "minLength": 1},
          "superseded_reason": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"not": {"const": "superseded"}}
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "superseded_by": {"type": "null"},
          "superseded_reason": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"const": "pass"}
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "exit_code": {"const": 0},
          "assertions": {
            "items": {
              "properties": {
                "result": {"const": "pass"}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"const": "fail"}
        },
        "required": ["status"]
      },
      "then": {
        "anyOf": [
          {"properties": {"exit_code": {"not": {"const": 0}}}},
          {"properties": {"assertions": {"contains": {"properties": {"result": {"const": "fail"}}, "required": ["result"]}}}}
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {"const": "pass"}
        },
        "required": ["status"]
      },
      "then": {
        "required": ["attestation"],
        "properties": {
          "attestation": {"type": "object"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"const": "not-applicable-approved"}
        },
        "required": ["status"]
      },
      "then": {
        "required": ["attestation"],
        "properties": {
          "attestation": {"type": "object"}
        }
      }
    }
  ],
  "$defs": {
    "git_oid": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ed25519_signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    }
  }
}
