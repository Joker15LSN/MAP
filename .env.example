# Optional port overrides for docker-compose.yml
MAP_FRONTEND_PORT=5174
MAP_BFF_PORT=18080
MAP_ALGO_PORT=10000
MAP_ALGO_PLATFORM=linux/amd64
MAP_OBS_FRONTEND_PORT=15152
MAP_OBS_BACKEND_PORT=15151
MAP_POSTGRES_PORT=15432
MAP_MONGO_PORT=27017

# Runtime LLM (OpenAI-compatible)
MAP_LLM_BASE_URL=https://api.deepseek.com
MAP_LLM_MODEL=deepseek-v4-flash
MAP_LLM_API_KEY=

# ---------------------------------------------------------------------------
# OpenTelemetry (optional)
#
# Enablement semantics (priority order):
#   1. OTEL_SDK_DISABLED=true       -> force off, wins over everything
#   2. MAP_OTEL_ENABLED=true        -> the ONLY switch that turns OTel on
#   3. OTEL_EXPORTER_OTLP_*         -> export targets only, never enable OTel
#
# With docker-compose the Collector only exists in the `otel` profile; start
# the full observability stack with:
#   docker compose -f docker-compose.yml -f docker-compose.otel.yml \
#     --profile otel up -d
# Without the otel profile keep MAP_OTEL_ENABLED=false (the default),
# otherwise exporters will retry against a missing collector.
MAP_OTEL_ENABLED=false
#
# === Compose 支持(otel profile 下透传到容器)===
# 以下变量由 docker-compose 映射,在 bundled stack 下真实生效。
#
# Emergency kill switch, highest priority: when true the SDK stays fully
# disabled even if MAP_OTEL_ENABLED=true. docker-compose passes this value
# through to BOTH services (base compose, no profile needed):
#   OTEL_SDK_DISABLED=true
# Note: evaluated once at process startup — flipping it in a live process has
# no effect until the service restarts (telemetry is a process-lifetime
# one-shot by design).
#
# MAP_OTEL_PROTOCOL and the collector endpoint form ONE configuration pair —
# docker-compose maps both to BOTH services (algorithm-service and
# backend-service) identically, so a protocol switch can never split the
# fleet. The endpoint port MUST match the protocol:
#   MAP_OTEL_PROTOCOL=http/protobuf  -> MAP_OTEL_ENDPOINT=http://otel-collector:4318
#   MAP_OTEL_PROTOCOL=grpc           -> MAP_OTEL_ENDPOINT=http://otel-collector:4317
#MAP_OTEL_PROTOCOL=http/protobuf          # http/protobuf (default) | grpc
#MAP_OTEL_ENDPOINT=http://otel-collector:4318
#
# Head-based sampling: 1.0 = keep everything (dev), e.g. 0.1 in production.
# Passed through to BOTH services (otel profile).
#MAP_OTEL_SAMPLING_RATIO=1.0
#
# Comma-separated request paths that never produce HTTP spans.
# docker-compose passes this through to BOTH services (otel profile).
#MAP_OTEL_EXCLUDED_PATHS=/health,/metrics
#
# Batch exporter tuning (raise for high-throughput production deployments).
# docker-compose (otel profile) passes MAP_OTEL_MAX_QUEUE_SIZE,
# MAP_OTEL_MAX_EXPORT_BATCH_SIZE and MAP_OTEL_EXPORT_TIMEOUT_MS through to
# BOTH services. Constraint: max_export_batch_size <= max_queue_size
# (the SDK rejects violating pairs at startup).
#MAP_OTEL_MAX_QUEUE_SIZE=2048
#MAP_OTEL_MAX_EXPORT_BATCH_SIZE=512
#MAP_OTEL_EXPORT_TIMEOUT_MS=10000
#
# === algorithm-service 专属(Compose otel profile 透传)===
# 以下仅 map_core(algorithm-service)读取。BFF 当前未实现任何 OTel 日志
# 导出:既没有 native OTLP log exporter,也没有 log-to-span-event bridge,
# 因此这些变量对 BFF 无效。
#
# Native-log pipeline tuning:
#MAP_OTEL_LOG_MAX_QUEUE_SIZE=2048
#MAP_OTEL_LOG_MAX_EXPORT_BATCH_SIZE=512
#MAP_OTEL_LOG_EXPORT_TIMEOUT_MS=10000
# Max characters kept per log message after redaction.
#MAP_OTEL_LOG_MESSAGE_MAX_CHARS=4000
# Mirror logs as events on the current span (Phoenix/Jaeger-friendly) —
# implemented by map_core's emit_loguru(); the BFF has no such bridge.
# Bundled stack 推荐路径:Collector 只跑 traces pipeline,logs-as-span-events
# 默认开启。
#MAP_OTEL_LOGS_AS_SPAN_EVENTS=true
#
# === 进程直接部署 / 外部 Collector 专用(Compose 不透传)===
# 以下变量在 docker-compose 的 bundled stack 下不生效。Compose 只映射
# MAP_OTEL_PROTOCOL/MAP_OTEL_ENDPOINT 到标准 OTEL_EXPORTER_OTLP_PROTOCOL/
# OTEL_EXPORTER_OTLP_ENDPOINT;per-signal 端点与 native-log 开关不做映射,
# 只适用于直接进程部署或指向外部 Collector 的场景。
#
# OTEL_EXPORTER_OTLP_ENDPOINT is the shared fallback for traces and logs.
# Per-signal endpoints take precedence and may point at different backends:
#   - OTEL_EXPORTER_OTLP_TRACES_ENDPOINT  spans only
#   - OTEL_EXPORTER_OTLP_LOGS_ENDPOINT    native logs only
# Endpoint format depends on the protocol:
#   http/protobuf: http://otel-collector:4318 (SDK appends /v1/traces, /v1/logs)
#   grpc:          http://otel-collector:4317 (no path suffix)
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
#
# Export native loguru logs via OTLP logs pipeline (independent of traces).
# Defaults on when a logs endpoint is configured; an explicit "false" here
# force-disables native log export even if a logs endpoint is set. Redaction
# applies to both native logs and span-event logs via a shared sanitizer.
# NOTE: the bundled Collector (docker compose --profile otel) only runs a
# traces pipeline — keep native logs disabled there (overlay already forces
# this) and rely on MAP_OTEL_LOGS_AS_SPAN_EVENTS instead.
#MAP_OTEL_NATIVE_LOG_EXPORT_ENABLED=false
#
# Production recommendations: MAP_OTEL_SAMPLING_RATIO<=0.2, dedicated
# Collector with its own resource limits, and OTLP over grpc to reduce
# serialization overhead.
# ---------------------------------------------------------------------------

# Agent execution engine: legacy | agentscope (request-level dispatch_config.engine
# and AdminState agent_engine override this default)
MAP_AGENT_ENGINE=legacy
